# Supabase Configuration (Client & Server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# Supabase Service Role Key (SERVER ONLY - NEVER expose to browser or client bundle)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key

# Secret token for Tampermonkey Userscript sync (/api/import)
IMPORT_TOKEN=comicplan_import_token_change_in_production

# Optional: Single-user allowlist email
ALLOWED_USER_EMAIL=owner@example.com
